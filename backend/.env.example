DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=troque-por-um-valor-aleatorio
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_ADMIN_URL=painel-interno/
# Gere com: uv run python -c "from vault.crypto import generate_master_key as g; print(g())"
VAULT_MASTER_KEY=
DATABASE_NAME=renave
DATABASE_USER=renave
DATABASE_PASSWORD=renave_dev
DATABASE_HOST=localhost
DATABASE_PORT=5442
REDIS_URL=redis://localhost:6390/0
CORS_ALLOWED_ORIGINS=http://localhost:5180
PUBLIC_API_URL=http://localhost:8010

# BusCars (consultas)
BUSCARS_API_KEY=
BUSCARS_WEBHOOK_SECRET=
# Carven (homologação: credenciais de teste publicadas na documentação da Carven)
CARVEN_BASE_URL=https://homologacao.carven.com.br
CARVEN_CLIENT_ID=
CARVEN_CLIENT_SECRET=
# Geranet (NF-e) — 2 = homologação
GERANET_API_KEY=
GERANET_AMBIENTE=2
# Fotos e documentos no Cloudflare R2 (sem R2_BUCKET, ficam no disco em backend/media)
R2_BUCKET=
R2_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_REGION=auto
R2_PUBLIC_DOMAIN=
# Consulta de placa (API PLACAS / wdapi2) e FIPE (Parallelum; token opcional para mais consultas)
PLACA_API_BASE_URL=https://wdapi2.com.br
PLACA_API_TOKEN=
FIPE_API_TOKEN=
# Assinatura eletrônica (ZapSign). Produção: https://api.zapsign.com.br
ZAPSIGN_BASE_URL=https://sandbox.api.zapsign.com.br
ZAPSIGN_API_TOKEN=
# Webhook no painel ZapSign: <PUBLIC_API_URL>/api/hooks/zapsign/<ZAPSIGN_WEBHOOK_TOKEN>
ZAPSIGN_WEBHOOK_TOKEN=
# Domínio do site das lojas (<loja>.STOREFRONT_DOMAIN)
STOREFRONT_DOMAIN=revendadigital.kaibez.com.br
# Asaas (faturas e recargas). Sandbox: https://api-sandbox.asaas.com/v3 · produção: https://api.asaas.com/v3
# Sem a chave, faturas e recargas ficam para confirmação manual no backoffice.
ASAAS_BASE_URL=https://api-sandbox.asaas.com/v3
ASAAS_API_KEY=
# Token definido no cadastro do webhook no painel Asaas (URL: <PUBLIC_API_URL>/api/hooks/asaas)
ASAAS_WEBHOOK_TOKEN=

# E-mail (Resend). Sem a chave, os e-mails aparecem no console.
RESEND_API_KEY=
DEFAULT_FROM_EMAIL=REVENDA DIGITAL <nao-responda@kaibez.com.br>
SUPPORT_EMAIL=contato@kaibez.com.br
PRIVACY_EMAIL=privacidade@kaibez.com.br

SENTRY_DSN=
